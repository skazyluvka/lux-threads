<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.clothingstore.controller.ProfileController"
            styleClass="root-pane">
    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Button text="← Назад" styleClass="btn-outline-sm" onAction="#handleBack"/>
            <Label text="Личный кабинет" styleClass="page-title"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="Выйти" styleClass="btn-danger-sm" onAction="#handleLogout"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="transparent-scroll">
            <HBox spacing="24" alignment="TOP_LEFT">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                <!-- Левая колонка -->
                <VBox spacing="20" prefWidth="380">

                    <!-- Личная информация -->
                    <VBox styleClass="card" spacing="16">
                        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="👤" style="-fx-font-size:32px;"/>
                            <VBox spacing="4">
                                <Label fx:id="emailLabel" styleClass="section-title"/>
                                <Label fx:id="roleLabel" styleClass="muted-label"/>
                            </VBox>
                        </HBox>
                        <Separator/>
                        <Label text="Личная информация" styleClass="field-label"/>
                        <VBox spacing="6">
                            <Label text="Имя" styleClass="field-label"/>
                            <TextField fx:id="firstNameField" promptText="Иван" styleClass="text-field-dark"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Фамилия" styleClass="field-label"/>
                            <TextField fx:id="lastNameField" promptText="Иванов" styleClass="text-field-dark"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Телефон" styleClass="field-label"/>
                            <TextField fx:id="phoneField" promptText="+7 (999) 000-00-00" styleClass="text-field-dark"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Адрес" styleClass="field-label"/>
                            <TextField fx:id="addressField" promptText="Город, улица, дом" styleClass="text-field-dark"/>
                        </VBox>
                        <Label fx:id="profileMsgLabel" visible="false" wrapText="true"/>
                        <Button text="💾 Сохранить" styleClass="btn-primary"
                                maxWidth="Infinity" onAction="#handleSaveProfile"/>
                    </VBox>

                    <!-- Сброс пароля -->
                    <VBox styleClass="card" spacing="16">
                        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                        <Label text="🔒 Сброс пароля" styleClass="section-title"/>
                        <Label text="Письмо со ссылкой для сброса придёт на указанный email."
                               styleClass="muted-label" wrapText="true"/>
                        <VBox spacing="6">
                            <Label text="Email" styleClass="field-label"/>
                            <TextField fx:id="resetEmailField" styleClass="text-field-dark"/>
                        </VBox>
                        <Label fx:id="resetMsgLabel" visible="false" wrapText="true"/>
                        <Button text="📧 Отправить письмо" styleClass="btn-outline"
                                maxWidth="Infinity" onAction="#handleResetPassword"/>
                    </VBox>

                    <!-- Стать продавцом (показывается покупателям) -->
                    <VBox fx:id="sellerBecomeCard" styleClass="card" spacing="16"
                          visible="false" managed="false">
                        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="🏪" style="-fx-font-size:24px;"/>
                            <Label text="Стать продавцом" styleClass="section-title"/>
                        </HBox>
                        <Label text="Создайте профиль продавца, чтобы выставлять товары и публиковать посты о своих коллекциях."
                               styleClass="muted-label" wrapText="true"/>
                        <VBox spacing="6">
                            <Label text="Название магазина / ник" styleClass="field-label"/>
                            <TextField fx:id="becomeSellerNameField"
                                       promptText="Например: StreetStyle_Shop"
                                       styleClass="text-field-dark"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="О себе (необязательно)" styleClass="field-label"/>
                            <TextArea fx:id="becomeSellerBioArea"
                                      promptText="Расскажи о своём стиле и товарах"
                                      styleClass="text-area-dark"
                                      prefHeight="90" wrapText="true"/>
                        </VBox>
                        <Label fx:id="becomeMsgLabel" visible="false" wrapText="true"/>
                        <Button text="🚀 Стать продавцом" styleClass="btn-primary"
                                maxWidth="Infinity" onAction="#handleBecomeSeller"/>
                    </VBox>

                    <!-- Профиль продавца (показывается продавцам) -->
                    <VBox fx:id="sellerProfileCard" styleClass="card" spacing="16"
                          visible="false" managed="false">
                        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="🏪" style="-fx-font-size:24px;"/>
                            <Label text="Профиль продавца" styleClass="section-title"/>
                        </HBox>
                        <Label fx:id="sellerRatingLabel" styleClass="muted-label"/>
                        <Button text="Открыть мой профиль →" styleClass="btn-outline"
                                maxWidth="Infinity" onAction="#handleOpenSellerProfile"/>
                        <Separator/>
                        <Label text="Редактировать профиль продавца" styleClass="field-label"/>
                        <VBox spacing="6">
                            <Label text="Название магазина / ник" styleClass="field-label"/>
                            <TextField fx:id="editSellerNameField"
                                       promptText="Название магазина"
                                       styleClass="text-field-dark"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="О себе" styleClass="field-label"/>
                            <TextArea fx:id="editSellerBioArea"
                                      promptText="Описание продавца"
                                      styleClass="text-area-dark"
                                      prefHeight="90" wrapText="true"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Ссылка на аватар (URL, необязательно)" styleClass="field-label"/>
                            <TextField fx:id="editSellerAvatarField"
                                       promptText="https://..."
                                       styleClass="text-field-dark"/>
                        </VBox>
                        <Label fx:id="editSellerMsgLabel" visible="false" wrapText="true"/>
                        <Button text="💾 Сохранить профиль продавца" styleClass="btn-outline"
                                maxWidth="Infinity" onAction="#handleUpdateSellerProfile"/>
                    </VBox>

                </VBox>

                <!-- История заказов -->
                <VBox HBox.hgrow="ALWAYS" spacing="16">
                    <Label text="История заказов" styleClass="section-title"/>
                    <Label fx:id="ordersEmptyLabel" text="У вас пока нет заказов"
                           styleClass="muted-label" visible="false"/>
                    <ScrollPane fitToWidth="true" styleClass="transparent-scroll" prefHeight="600">
                        <VBox fx:id="ordersBox" spacing="12"/>
                    </ScrollPane>
                </VBox>

            </HBox>
        </ScrollPane>
    </center>
</BorderPane>