<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.clothingstore.controller.RegisterController"
           styleClass="root-pane">
    <VBox alignment="CENTER" spacing="0" maxWidth="420">
        <VBox styleClass="auth-card" spacing="20">
            <padding><Insets top="48" right="40" bottom="48" left="40"/></padding>

            <Label text="LUXE THREADS" styleClass="brand-logo"/>
            <Label text="Создать аккаунт" styleClass="auth-subtitle"/>

            <VBox spacing="8">
                <Label text="Email" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="your@email.com" styleClass="text-field-dark"/>
            </VBox>
            <VBox spacing="8">
                <Label text="Пароль" styleClass="field-label"/>
                <PasswordField fx:id="passField" promptText="Минимум 6 символов" styleClass="text-field-dark"/>
            </VBox>
            <VBox spacing="8">
                <Label text="Повторите пароль" styleClass="field-label"/>
                <PasswordField fx:id="confirmField" promptText="••••••••" styleClass="text-field-dark"/>
            </VBox>

            <Label fx:id="msgLabel" styleClass="error-label" visible="false" wrapText="true"/>

            <Button fx:id="registerBtn" text="Создать аккаунт" styleClass="btn-primary"
                    maxWidth="Infinity" onAction="#handleRegister"/>
            <Button text="← Назад к входу" styleClass="btn-link" onAction="#handleBack"/>
        </VBox>
    </VBox>
</StackPane>
