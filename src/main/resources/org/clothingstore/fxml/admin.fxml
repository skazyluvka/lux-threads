<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.clothingstore.controller.AdminController"
            style="-fx-background-color:#0e0e1a;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color:#13131f;
                     -fx-border-color:#1e1e30;
                     -fx-border-width: 0 0 1 0;">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Button text="← Назад" styleClass="btn-outline-sm" onAction="#handleBack"/>
            <Label text="⚙ Панель администратора"
                   style="-fx-text-fill:#e8e8f0;
                          -fx-font-size:18px; -fx-font-weight:bold;"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color:#0e0e1a;">

            <!-- ════════ ТОВАРЫ ════════ -->
            <Tab text="📦 Товары">
                <HBox spacing="20">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                    <!-- Таблица -->
                    <TableView fx:id="productsTable"
                               HBox.hgrow="ALWAYS" prefHeight="600"
                               styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colPId"
                                         text="ID"       prefWidth="55"/>
                            <TableColumn fx:id="colPName"
                                         text="Название" prefWidth="240"/>
                            <TableColumn fx:id="colPPrice"
                                         text="Цена ₽"  prefWidth="100"/>
                            <TableColumn fx:id="colPActive"
                                         text="Активен"  prefWidth="80"/>
                        </columns>
                        <placeholder>
                            <Label text="Нет товаров"
                                   style="-fx-text-fill:#55556a;"/>
                        </placeholder>
                    </TableView>

                    <!-- Форма -->
                    <ScrollPane fitToWidth="true" prefWidth="320"
                                style="-fx-background-color:#13131f;
                                       -fx-background:#13131f;">
                        <VBox spacing="12"
                              style="-fx-background-color:#13131f;
                                     -fx-background-radius:14px;
                                     -fx-border-color:#2a2a3e;
                                     -fx-border-radius:14px;
                                     -fx-border-width:1px;">
                            <padding>
                                <Insets top="20" right="16" bottom="20" left="16"/>
                            </padding>

                            <Label text="Добавить / Изменить товар"
                                   style="-fx-text-fill:#e8e8f0;
                                          -fx-font-size:15px;
                                          -fx-font-weight:bold;"/>

                            <VBox spacing="5">
                                <Label text="Название" styleClass="field-label"/>
                                <TextField fx:id="pNameField"
                                           styleClass="text-field-dark"/>
                            </VBox>

                            <VBox spacing="5">
                                <Label text="Описание" styleClass="field-label"/>
                                <TextArea fx:id="pDescField"
                                          styleClass="text-area-dark"
                                          prefHeight="70" wrapText="true"/>
                            </VBox>

                            <VBox spacing="5">
                                <Label text="Цена (₽)" styleClass="field-label"/>
                                <TextField fx:id="pPriceField"
                                           styleClass="text-field-dark"/>
                            </VBox>

                            <VBox spacing="5">
                                <Label text="Категория" styleClass="field-label"/>
                                <ComboBox fx:id="pCategoryCombo"
                                          maxWidth="Infinity"
                                          styleClass="combo-dark"/>
                            </VBox>

                            <CheckBox fx:id="pActiveCheck" text="Активен"
                                      styleClass="custom-checkbox"/>

                            <Separator style="-fx-background-color:#2a2a3e;"/>

                            <!-- ★ БЛОК ФОТО -->
                            <Label text="Изображение товара"
                                   styleClass="field-label"/>

                            <ImageView fx:id="pImagePreview"
                                       fitWidth="288" fitHeight="160"
                                       preserveRatio="true" smooth="true"
                                       visible="false" managed="false">
                                <style>
                                    -fx-background-radius: 8px;
                                </style>
                            </ImageView>

                            <Label fx:id="pImageLabel"
                                   text="Фото не выбрано"
                                   style="-fx-text-fill:#55556a;
                                          -fx-font-size:12px;"
                                   wrapText="true"/>

                            <HBox spacing="8">
                                <Button text="📁 Выбрать фото"
                                        styleClass="btn-outline"
                                        onAction="#handleChooseImage"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"/>
                                <Button text="🗑"
                                        styleClass="btn-danger-sm"
                                        onAction="#handleRemoveImage"/>
                            </HBox>

                            <Separator style="-fx-background-color:#2a2a3e;"/>

                            <Label fx:id="pMsgLabel"
                                   visible="false" wrapText="true"/>

                            <HBox spacing="8">
                                <Button text="➕ Добавить"
                                        styleClass="btn-primary"
                                        onAction="#handleAddProduct"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"/>
                                <Button text="✏ Обновить"
                                        styleClass="btn-outline"
                                        onAction="#handleUpdateProduct"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"/>
                                <Button text="🗑"
                                        styleClass="btn-danger-sm"
                                        onAction="#handleDeleteProduct"/>
                            </HBox>
                        </VBox>
                    </ScrollPane>
                </HBox>
            </Tab>

            <!-- ════════ КАТЕГОРИИ ═══════ -->
            <Tab text="🗂 Категории">
                <HBox spacing="20">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                    <TableView fx:id="categoriesTable"
                               HBox.hgrow="ALWAYS" prefHeight="500"
                               styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colCId"
                                         text="ID"        prefWidth="55"/>
                            <TableColumn fx:id="colCName"
                                         text="Название"  prefWidth="180"/>
                            <TableColumn fx:id="colCDesc"
                                         text="Описание"  prefWidth="300"/>
                        </columns>
                        <placeholder>
                            <Label text="Нет категорий"
                                   style="-fx-text-fill:#55556a;"/>
                        </placeholder>
                    </TableView>

                    <VBox spacing="12" prefWidth="280"
                          style="-fx-background-color:#13131f;
                                 -fx-background-radius:14px;
                                 -fx-border-color:#2a2a3e;
                                 -fx-border-radius:14px;
                                 -fx-border-width:1px;">
                        <padding>
                            <Insets top="20" right="16" bottom="20" left="16"/>
                        </padding>
                        <Label text="Добавить / Изменить"
                               style="-fx-text-fill:#e8e8f0;
                                      -fx-font-size:15px;
                                      -fx-font-weight:bold;"/>
                        <VBox spacing="5">
                            <Label text="Название" styleClass="field-label"/>
                            <TextField fx:id="cNameField"
                                       styleClass="text-field-dark"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Описание" styleClass="field-label"/>
                            <TextField fx:id="cDescField"
                                       styleClass="text-field-dark"/>
                        </VBox>
                        <Label fx:id="cMsgLabel"
                               visible="false" wrapText="true"/>
                        <HBox spacing="8">
                            <Button text="➕ Добавить"
                                    styleClass="btn-primary"
                                    onAction="#handleAddCategory"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="✏ Обновить"
                                    styleClass="btn-outline"
                                    onAction="#handleUpdateCategory"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="🗑"
                                    styleClass="btn-danger-sm"
                                    onAction="#handleDeleteCategory"/>
                        </HBox>
                    </VBox>
                </HBox>
            </Tab>

            <!-- ════════ ПРОМОКОДЫ ═══════ -->
            <Tab text="🎟 Промокоды">
                <HBox spacing="20">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                    <TableView fx:id="promoTable"
                               HBox.hgrow="ALWAYS" prefHeight="500"
                               styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colPromoId"
                                         text="ID"       prefWidth="55"/>
                            <TableColumn fx:id="colPromoCode"
                                         text="Код"      prefWidth="160"/>
                            <TableColumn fx:id="colPromoDiscount"
                                         text="Скидка %" prefWidth="90"/>
                            <TableColumn fx:id="colPromoActive"
                                         text="Активен"  prefWidth="80"/>
                        </columns>
                        <placeholder>
                            <Label text="Нет промокодов"
                                   style="-fx-text-fill:#55556a;"/>
                        </placeholder>
                    </TableView>

                    <VBox spacing="12" prefWidth="280"
                          style="-fx-background-color:#13131f;
                                 -fx-background-radius:14px;
                                 -fx-border-color:#2a2a3e;
                                 -fx-border-radius:14px;
                                 -fx-border-width:1px;">
                        <padding>
                            <Insets top="20" right="16" bottom="20" left="16"/>
                        </padding>
                        <Label text="Новый промокод"
                               style="-fx-text-fill:#e8e8f0;
                                      -fx-font-size:15px;
                                      -fx-font-weight:bold;"/>
                        <VBox spacing="5">
                            <Label text="Код" styleClass="field-label"/>
                            <TextField fx:id="promoCodeField"
                                       promptText="PROMO2026"
                                       styleClass="text-field-dark"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Скидка %" styleClass="field-label"/>
                            <TextField fx:id="promoDiscountField"
                                       promptText="10"
                                       styleClass="text-field-dark"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Макс. использований"
                                   styleClass="field-label"/>
                            <TextField fx:id="promoMaxUsesField"
                                       promptText="Без ограничений"
                                       styleClass="text-field-dark"/>
                        </VBox>
                        <CheckBox fx:id="promoActiveCheck" text="Активен"
                                  styleClass="custom-checkbox"/>
                        <Label fx:id="promoMsgLabel"
                               visible="false" wrapText="true"/>
                        <HBox spacing="8">
                            <Button text="➕ Создать"
                                    styleClass="btn-primary"
                                    onAction="#handleAddPromo"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="🔄 Вкл/Выкл"
                                    styleClass="btn-outline"
                                    onAction="#handleTogglePromo"/>
                            <Button text="🗑"
                                    styleClass="btn-danger-sm"
                                    onAction="#handleDeletePromo"/>
                        </HBox>
                    </VBox>
                </HBox>
            </Tab>

            <!-- ════════ ЗАКАЗЫ ════════ -->
            <Tab text="📋 Заказы">
                <VBox spacing="16">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <HBox spacing="12" alignment="CENTER_LEFT"
                          style="-fx-background-color:#13131f;
                                 -fx-background-radius:10px;
                                 -fx-padding:12px;
                                 -fx-border-color:#2a2a3e;
                                 -fx-border-radius:10px;
                                 -fx-border-width:1px;">
                        <Label text="Изменить статус:"
                               styleClass="field-label"/>
                        <ComboBox fx:id="statusCombo"
                                  prefWidth="190"
                                  styleClass="combo-dark"/>
                        <Button text="✓ Применить"
                                styleClass="btn-primary"
                                onAction="#handleUpdateOrderStatus"/>
                        <Label fx:id="oMsgLabel"
                               visible="false" wrapText="true"/>
                    </HBox>

                    <TableView fx:id="ordersTable"
                               VBox.vgrow="ALWAYS" prefHeight="500"
                               styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colOId"
                                         text="ID"     prefWidth="60"/>
                            <TableColumn fx:id="colOStatus"
                                         text="Статус" prefWidth="130"/>
                            <TableColumn fx:id="colOTotal"
                                         text="Сумма"  prefWidth="120"/>
                            <TableColumn fx:id="colODate"
                                         text="Дата"   prefWidth="200"/>
                        </columns>
                        <placeholder>
                            <Label text="Нет заказов"
                                   style="-fx-text-fill:#55556a;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>